rules_version = '2';

// Only the Nestra backend (Firebase Admin SDK, which bypasses these rules)
// reads and writes Firestore. Apps talk to the backend, never to Firestore
// directly, so every direct client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
