# Copy to .env (git-ignored) and adjust. uvicorn loads it with --env-file .env
#
# Sign-in: none = no login, one shared home. firebase = Firebase accounts, one home per user.
NESTRA_AUTH=firebase
# Storage: file = JSON files under var/. firestore = Firestore (needs the key below).
NESTRA_STORAGE=firestore
# Service-account key from Firebase console > Project settings > Service accounts.
# Keep it in var/ (git-ignored). Never commit or share it.
NESTRA_FIREBASE_CREDENTIALS=var/firebase-admin.json
# New users start with empty rooms (starter) or sample devices (demo).
NESTRA_NEW_HOME=starter
# Simulated seconds per real second.
NESTRA_TIME_SCALE=10
